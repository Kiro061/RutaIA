    {
      "parameters": {
        "jsCode": "const respuesta = $json.choices[0].message.content;\nconst formateado = $('Formatear Contexto').item.json;\n\nreturn {\n  json: {\n    consulta_id: formateado.consulta_id,\n    pregunta: formateado.pregunta,\n    respuesta,\n    fuentes:formateado.resultados.map( r=> ({\n      id: r.payload.curso_id,\n      nombre: r.payload.nombre,\n      categoria: r.payload.categoria,\n      nivel: r.payload.nivel,\n      similitud: r.score\n    })),\n    estado: 'Respondida'\n  }\n};"
      },
