        "method": "POST",
        "url": "http://qdrant:6333/collections/cursos/points/search",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify((()=> {\n    const body = $('Webhook - Recibir Consulta').item.json.body;\n    const nivel = String(body.nivel || '').normalize('NFD').replace(/[\\u300-\\u036f]/g,'').trim().toUppeCase();\n    const req = {vector :$json.data[0].embedding, limit: 5, score_threshold: 0.4, with_payload: true};\n      if (nivel) {req.filter = { must: [ {key: 'nivel', match: { value : nivel } } ] }; }\n      return req;\n    })()) }}",
        "options": {}
      },
