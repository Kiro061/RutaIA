    {
      "parameters": {
        "jsCode": "const respuesta = $json.choices[0].message.content;\nconst formateado = $('Formatear Contexto').item.json;\n\nreturn {\n  json: {\n    consulta_id: formateado.consulta_id,\n    pregunta: formateado.pregunta,\n    respuesta,\n    estado: 'Respondida'\n  }\n};"
      },
